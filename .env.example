# SWARM_CONSOLIDATED environment configuration
# Copy this file to .env and fill in your values.
# Keys are read from this file by the swarm scripts.

# LiteLLM proxy (localhost:4000) — all swarms route through this by default
SWARM_PROXY_URL=http://localhost:4000/v1

# SubQ Snap 1.2 API keys (decision model — PASS/FAIL verdicts only, not code generation)
# Get keys at: https://dashboard.subq.ai
SUBQ_FREE_API_KEY=your_subq_free_api_key_here
SUBQ_TOKEN_API_KEY=your_subq_token_api_key_here

# OpenRouter (optional — if you want paid models via proxy)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_KEY_ALT=your_openrouter_alt_api_key_here

# Swarm model server (localhost:8766) — swarm architectures as models
SWARM_MODEL_API_KEY=your_swarm_model_api_key_here

# Swarm behavior
SWARM_COST_CAP_USD=0.05
SWARM_MAX_ROUNDS=3
SWARM_PROXY_TIMEOUT=8
